	<string>$(WE_SHARE_INBOX_ENABLED)</string>
	<key>WESharedJourneysEnabled</key>
	<string>$(WE_SHARED_JOURNEYS_ENABLED)</string>
	<key>WESupportURL</key>
	<string>https://we-privacy-policy.kanfery.chatgpt.site</string>
	<key>WESupportEmail</key>
	<string>kanfer.ryan@gmail.com</string>
