			<string>com.ryankanfer.WE.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>we</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAccentColorName</key>
	<string>AccentColor</string>
