	<array>
		<string>Newsreader_14pt-Light.ttf</string>
		<string>Newsreader_14pt-LightItalic.ttf</string>
		<string>Newsreader_14pt-Regular.ttf</string>
		<string>Newsreader_14pt-Italic.ttf</string>
		<string>Newsreader_36pt-Light.ttf</string>
		<string>Newsreader_36pt-LightItalic.ttf</string>
		<string>Newsreader_36pt-Regular.ttf</string>
		<string>Newsreader_36pt-Italic.ttf</string>
		<string>DMSans-9pt.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
